+.legend-item b { color: var(--ink); font-family: var(--mono); }
+.legend-dot { width: 9px; height: 9px; border-radius: 2px; }
+
+/* ---- barras de emitentes ---- */
+.emit-bars { display: flex; flex-direction: column; gap: 0.7rem; }
+.emit-bar__head {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  font-size: 0.78rem;
+  margin-bottom: 0.3rem;
+  gap: 1rem;
+}
+.emit-bar__name { color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.emit-bar__val { font-family: var(--mono); font-weight: 500; color: var(--ink); flex-shrink: 0; }
+.emit-bar__track { height: 6px; background: var(--surface-3); border-radius: 2px; overflow: hidden; }
+.emit-bar__fill { height: 100%; border-radius: 2px; transition: width 0.5s ease; }
+
+/* ---- gráfico de barras mensal ---- */
+.bars {
+  display: flex;
+  align-items: flex-end;
+  gap: 8px;
+  height: 160px;
+  padding-top: 12px;
+}
+.bar-col {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 5px;
+  height: 100%;
+  justify-content: flex-end;
+}
+.bar-val { font-family: var(--mono); font-size: 0.6rem; color: var(--ink-3); }
+.bar {
+  width: 100%;
+  max-width: 34px;
+  background: var(--accent);
+  border-radius: 2px 2px 0 0;
+  transition: height 0.5s ease;
+}
+.bar-col:hover .bar { background: var(--accent-hover); }
+.bar-label { font-size: 0.62rem; color: var(--muted); white-space: nowrap; }
+.bar-label em { color: var(--border-2); font-style: normal; }
+
+@media (max-width: 900px) {
+  .stat-grid { grid-template-columns: 1fr 1fr; }
+  .dash-row { grid-template-columns: 1fr; }
+}
