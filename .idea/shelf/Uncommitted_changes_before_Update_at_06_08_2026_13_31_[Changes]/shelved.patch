+
+:root {
+  /* superfícies */
+  --bg: #eceef2;
+  --surface: #ffffff;
+  --surface-2: #f5f7f9;
+  --surface-3: #eef1f4;
+
+  /* tinta */
+  --ink: #0f1b2d;
+  --ink-2: #33414f;
+  --ink-3: #55616f;
+  --muted: #78859a;
+
+  /* traços */
+  --border: #dbe0e6;
+  --border-2: #c6cdd6;
+
+  /* acento institucional */
+  --accent: #1652a8;
+  --accent-hover: #0f4590;
+  --accent-weak: #e9f0f9;
+
+  /* barra lateral escura */
+  --nav-bg: #0f1b2d;
+  --nav-bg-2: #0b1523;
+  --nav-ink: #9aa7ba;
+  --nav-ink-strong: #eef2f7;
+  --nav-hover: rgba(255, 255, 255, 0.055);
+  --nav-active: rgba(76, 141, 255, 0.14);
+  --nav-accent: #4c8dff;
+
+  /* semânticos */
+  --saida: #b25a17;
+  --saida-weak: #f6efe7;
+  --entrada: #1f6bb8;
+  --entrada-weak: #e9f1fa;
+  --ok: #1c7a4a;
+  --ok-weak: #e5f1ea;
+  --err: #b0271f;
+  --err-weak: #fbebe9;
+  --warn: #8a6410;
+  --warn-weak: #f6efdd;
+
+  /* raios / sombra */
+  --r-sm: 2px;
+  --r: 3px;
+  --r-lg: 4px;
+  --shadow: 0 1px 2px rgba(15, 27, 45, 0.04), 0 1px 1px rgba(15, 27, 45, 0.03);
+
+  --font: 'IBM Plex Sans', system-ui, -apple-system, sans-serif;
+  --mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', 'Courier New', monospace;
 }
 
-html {
+* { box-sizing: border-box; }
+
+html { height: 100%; }
+
